<Project DefaultTargets="Build">
  <PropertyGroup Label="Globals">
	<ProjectGuid>{6B1E3C2A-4F1D-4C7E-9A11-2D0F6E7A1003}</ProjectGuid>
	<RootNamespace>OpenA2dp</RootNamespace>
	<TemplateGuid>{1bc93793-694f-48fe-9372-81e2b05556fd}</TemplateGuid>
	<ConfigurationType>Driver</ConfigurationType>
	<DriverType>KMDF</DriverType>
	<!-- ACX 1.1 requires KMDF 1.33 (Windows 11 22H2). -->
	<KMDF_VERSION_MAJOR>1</KMDF_VERSION_MAJOR>
	<KMDF_VERSION_MINOR>33</KMDF_VERSION_MINOR>
	<DriverTargetPlatform>Windows Driver</DriverTargetPlatform>
	<TargetVersion>Windows10</TargetVersion>
	<PlatformToolset>WindowsKernelModeDriver10.0</PlatformToolset>
	<WindowsTargetPlatformVersion>10.0.28000.0</WindowsTargetPlatformVersion>
	<SignMode>TestSign</SignMode>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <!-- The WDK props override OutDir/IntDir; restore the repo layout. -->
  <PropertyGroup>
	<OutDir>$(OpenA2dpRoot)out\$(Platform)\$(Configuration)\</OutDir>
	<IntDir>$(OpenA2dpRoot)obj\$(Platform)\$(Configuration)\$(MSBuildProjectName)\</IntDir>
  </PropertyGroup>
  <PropertyGroup>
	<AcxVersionMajor>1</AcxVersionMajor>
	<AcxVersionMinor>1</AcxVersionMinor>
	<AcxIncludeDir>$(WDKContentRoot)\Include\$(WindowsTargetPlatformVersion)\km\acx\km\$(AcxVersionMajor).$(AcxVersionMinor)</AcxIncludeDir>
	<AcxLibDir>$(WDKContentRoot)\Lib\$(WindowsTargetPlatformVersion)\km\$(Platform)\acx\km\$(AcxVersionMajor).$(AcxVersionMinor)</AcxLibDir>
  </PropertyGroup>
  <ItemDefinitionGroup>
	<ClCompile>
	  <AdditionalIncludeDirectories>$(AcxIncludeDir);%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
	  <PreprocessorDefinitions>ACX_VERSION_MAJOR=$(AcxVersionMajor);ACX_VERSION_MINOR=$(AcxVersionMinor);%(PreprocessorDefinitions)</PreprocessorDefinitions>
	</ClCompile>
	<Link>
	  <AdditionalDependencies>$(AcxLibDir)\acxstub.lib;%(AdditionalDependencies)</AdditionalDependencies>
	</Link>
	<DriverSign>
	  <FileDigestAlgorithm>sha256</FileDigestAlgorithm>
	</DriverSign>
	<Inf>
	  <!-- UTC date and version (1.yy.MMdd.HHmm): inf2cat rejects a local date ahead of UTC, and a date-based version always increases so PnP replaces the installed package. -->
	  <DateStamp>$([System.DateTime]::UtcNow.ToString('MM'))/$([System.DateTime]::UtcNow.ToString('dd'))/$([System.DateTime]::UtcNow.ToString('yyyy'))</DateStamp>
	  <TimeStamp>1.$([System.DateTime]::UtcNow.ToString('yy')).$([System.DateTime]::UtcNow.ToString('MMdd')).$([System.DateTime]::UtcNow.ToString('HHmm'))</TimeStamp>
	</Inf>
  </ItemDefinitionGroup>
  <ItemGroup>
	<PackageReference Include="Microsoft.Windows.WDK.x64" />
  </ItemGroup>
  <ItemGroup>
	<ClInclude Include="Driver.h" />
	<ClInclude Include="Service.h" />
	<ClCompile Include="Driver.cpp" />
	<ClCompile Include="L2cap.cpp" />
	<ClCompile Include="Signaling.cpp" />
	<ClCompile Include="Media.cpp" />
	<ClCompile Include="Audio.cpp" />
	<ClCompile Include="Service.cpp" />
	<Inf Include="OpenA2dp.inf" />
	<FilesToPackage Include="$(TargetPath)" />
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
</Project>
