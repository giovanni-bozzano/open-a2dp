<Project DefaultTargets="Build">
  <PropertyGroup Label="Globals">
	<ProjectGuid>{6B1E3C2A-4F1D-4C7E-9A11-2D0F6E7A1005}</ProjectGuid>
	<RootNamespace>OpenA2dpConfig</RootNamespace>
	<ConfigurationType>Application</ConfigurationType>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <ItemDefinitionGroup>
	<ClCompile>
	  <!-- The status report is shared with OpenA2dpCtl. -->
	  <AdditionalIncludeDirectories>$(OpenA2dpRoot)tools;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
	</ClCompile>
	<Link>
	  <SubSystem>Windows</SubSystem>
	  <!-- CM_Register_Notification: the control-device arrivals the window follows; dwmapi and
	       uxtheme: the dark title bar and the dark combo boxes; advapi32: the apps theme key;
	       setupapi and newdev: which A2DP node a sink is on, and moving it to the other driver;
	       ole32: whether the audio engine is playing to it; windowsapp: pausing that program
	       through the media transport manager so the node can be restarted. -->
	  <AdditionalDependencies>cfgmgr32.lib;comctl32.lib;dwmapi.lib;uxtheme.lib;advapi32.lib;setupapi.lib;newdev.lib;ole32.lib;windowsapp.lib;%(AdditionalDependencies)</AdditionalDependencies>
	  <!-- The control device is limited to Administrators, so ask for that up front. -->
	  <AdditionalOptions>/MANIFESTUAC:"level='requireAdministrator' uiAccess='false'" %(AdditionalOptions)</AdditionalOptions>
	</Link>
  </ItemDefinitionGroup>
  <ItemGroup>
	<ClCompile Include="main.cpp" />
	<ClCompile Include="StatusView.cpp" />
	<ClCompile Include="Theme.cpp" />
	<ClCompile Include="..\common\StatusReport.cpp" />
	<ClCompile Include="..\common\ControlDevice.cpp" />
	<ClCompile Include="..\common\SinkDriver.cpp" />
	<ClCompile Include="..\common\SinkPlayback.cpp" />
	<ClCompile Include="..\common\SinkPause.cpp" />
	<ClCompile Include="..\common\Text.cpp" />
	<ClInclude Include="StatusView.h" />
	<ClInclude Include="Theme.h" />
	<ClInclude Include="..\common\StatusReport.h" />
	<ClInclude Include="..\common\ControlDevice.h" />
	<ClInclude Include="..\common\SinkDriver.h" />
	<ClInclude Include="..\common\SinkPlayback.h" />
	<ClInclude Include="..\common\Text.h" />
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
</Project>
