<Project>
  <!-- Shared settings for every C++ project; project files only declare what is specific to them. -->
  <ItemGroup Label="ProjectConfigurations">
	<ProjectConfiguration Include="Debug|x64">
	  <Configuration>Debug</Configuration>
	  <Platform>x64</Platform>
	</ProjectConfiguration>
	<ProjectConfiguration Include="Release|x64">
	  <Configuration>Release</Configuration>
	  <Platform>x64</Platform>
	</ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup>
	<OpenA2dpRoot>$(MSBuildThisFileDirectory)</OpenA2dpRoot>
	<OutDir>$(OpenA2dpRoot)out\$(Platform)\$(Configuration)\</OutDir>
	<IntDir>$(OpenA2dpRoot)obj\$(Platform)\$(Configuration)\$(MSBuildProjectName)\</IntDir>
	<BaseIntermediateOutputPath>$(OpenA2dpRoot)obj\$(MSBuildProjectName)\</BaseIntermediateOutputPath>
	<RestoreProjectStyle>PackageReference</RestoreProjectStyle>
	<WindowsTargetPlatformVersion Condition="'$(WindowsTargetPlatformVersion)' == ''">10.0</WindowsTargetPlatformVersion>
	<PlatformToolset Condition="'$(PlatformToolset)' == ''">v145</PlatformToolset>
	<CharacterSet>Unicode</CharacterSet>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
	<UseDebugLibraries>true</UseDebugLibraries>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
	<UseDebugLibraries>false</UseDebugLibraries>
	<WholeProgramOptimization>true</WholeProgramOptimization>
  </PropertyGroup>
  <ItemDefinitionGroup>
	<ClCompile>
	  <LanguageStandard>stdcpp20</LanguageStandard>
	  <WarningLevel>Level4</WarningLevel>
	  <TreatWarningAsError>true</TreatWarningAsError>
	  <SDLCheck>true</SDLCheck>
	  <ConformanceMode>true</ConformanceMode>
	  <MultiProcessorCompilation>true</MultiProcessorCompilation>
	  <AdditionalIncludeDirectories>$(OpenA2dpRoot)common\include;$(OpenA2dpRoot)codecs\include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
		</ClCompile>
	  </ItemDefinitionGroup>
	  <ItemDefinitionGroup Condition="'$(ConfigurationType)' != 'Driver'">
		<ClCompile>
		  <PreprocessorDefinitions>WIN32_LEAN_AND_MEAN;NOMINMAX;_WIN32_WINNT=0x0A00;%(PreprocessorDefinitions)</PreprocessorDefinitions>
		</ClCompile>
	  </ItemDefinitionGroup>
	  <ItemDefinitionGroup Condition="'$(ConfigurationType)' != 'Driver' and '$(Configuration)' == 'Debug'">
		<ClCompile>
		  <PreprocessorDefinitions>_DEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
		</ClCompile>
	  </ItemDefinitionGroup>
	  <ItemDefinitionGroup Condition="'$(ConfigurationType)' != 'Driver' and '$(Configuration)' == 'Release'">
		<ClCompile>
		  <Optimization>MaxSpeed</Optimization>
		  <PreprocessorDefinitions>NDEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
		</ClCompile>
		<Link>
		  <LinkTimeCodeGeneration>UseLinkTimeCodeGeneration</LinkTimeCodeGeneration>
		</Link>
	  </ItemDefinitionGroup>
	  <!-- The CLI, the encoder service and the tests are copied to the test VM, which has
	       no Visual C++ debug runtime, so every user-mode binary links the CRT statically.
	       The static library uses the same runtime to keep one CRT in each process. -->
	  <ItemDefinitionGroup Condition="'$(ConfigurationType)' != 'Driver'">
		<ClCompile>
		  <RuntimeLibrary Condition="'$(Configuration)' == 'Debug'">MultiThreadedDebug</RuntimeLibrary>
		  <RuntimeLibrary Condition="'$(Configuration)' == 'Release'">MultiThreaded</RuntimeLibrary>
		  <!-- The WinRT calls the tools make report failure by throwing. -->
		  <ExceptionHandling>Sync</ExceptionHandling>
		</ClCompile>
	  </ItemDefinitionGroup>
	  <!-- The driver receives these transitively from Microsoft.Windows.WDK.x64.
	       The user-mode projects reference the pinned SDK packages directly so the
	       build does not need a Windows SDK installed alongside the build tools. -->
	  <ItemGroup Condition="'$(ConfigurationType)' != 'Driver' and '$(ConfigurationType)' != ''">
		<PackageReference Include="Microsoft.Windows.SDK.CPP" />
		<PackageReference Include="Microsoft.Windows.SDK.CPP.x64" />
	  </ItemGroup>
</Project>
